# Paywall for downloads. Leave off while testing; set to "on" once payments are live.
VITE_PAYWALL=off
# Accounts that always get full access, comma separated.
VITE_FREE_EMAILS=
# Stock photos. Openverse works without a key. Add these to also search Unsplash and Pexels.
# Unsplash: create an app at https://unsplash.com/oauth/applications and use its Access Key.
VITE_UNSPLASH_ACCESS_KEY=
# Pexels: get a key at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=
