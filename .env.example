# Paywall for downloads. Leave off while testing; set to "on" once payments are live.
VITE_PAYWALL=off
# Accounts that always get full access, comma separated.
VITE_FREE_EMAILS=
# Stock photos. Openverse works without a key.
# Unsplash (recommended): create an app at https://unsplash.com/oauth/applications and put its Access Key in
# UNSPLASH_ACCESS_KEY on Vercel. The api/unsplash.ts proxy uses it server-side, so the key never reaches the browser.
UNSPLASH_ACCESS_KEY=
# Only for local `npm run dev` without the proxy: the same key, exposed to the browser.
VITE_UNSPLASH_ACCESS_KEY=
# Pexels: get a key at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=
