# Accounts (Google sign-in) and saving projects to the account, via Supabase.
# Supabase -> Project Settings -> API: the Project URL and the anon / publishable key.
# Both are public by design (row-level security in supabase/schema.sql protects the data).
# Leave empty to run without accounts: no sign-in, everything stays in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Paywall for downloads. Leave off while testing; set to "on" once payments are live.
VITE_PAYWALL=off
# Accounts that always get full access, comma separated.
VITE_FREE_EMAILS=
# Stock photos. Openverse works without a key.
# Unsplash (recommended): create an app at https://unsplash.com/oauth/applications and put its Access Key in
# UNSPLASH_ACCESS_KEY on Vercel. The api/unsplash.ts proxy uses it server-side, so the key never reaches the browser.
UNSPLASH_ACCESS_KEY=
# Only for local `npm run dev` without the proxy: the same key, exposed to the browser.
VITE_UNSPLASH_ACCESS_KEY=
# Pexels (the default source): get a key at https://www.pexels.com/api/ and put it in PEXELS_API_KEY on Vercel.
# The api/pexels.ts proxy uses it server-side, so the key never reaches the browser.
PEXELS_API_KEY=
# Only for local `npm run dev` without the proxy: the same key, exposed to the browser.
VITE_PEXELS_API_KEY=
